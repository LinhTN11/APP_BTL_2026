{
  "name": "gap-dating-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo": "node scripts/demo.mjs",
    "dev": "node scripts/demo.mjs --no-android",
    "dev:api": "npm run dev --workspace @gap/api",
    "dev:mobile": "npm run start --workspace @gap/mobile -- --host 0.0.0.0",
    "android": "node scripts/android.mjs",
    "test:api": "npm run test:firestore",
    "test:api:reference": "npm test --workspace @gap/api --",
    "test:firestore": "node scripts/firestore-emulator.mjs",
    "demo:emulator": "node scripts/firestore-emulator.mjs --demo",
    "firestore:check": "node --import tsx scripts/firestore.mjs check",
    "firestore:seed": "node --import tsx scripts/firestore.mjs seed",
    "test:mobile": "npm test --workspace @gap/mobile -- --runInBand",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test:api && npm run test:mobile",
    "smoke:demo": "node scripts/firestore-emulator.mjs --smoke"
  },
  "devDependencies": {
    "firebase-tools": "15.34.2"
  }
}
