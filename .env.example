# Cloud Firestore is the primary DB. See docs/12-ket-noi-firestore.md.
DATABASE_MODE=firestore
FIREBASE_PROJECT_ID=
# Public Firebase Auth client config returned by the API; no Admin key in mobile.
# Register a Web app once in the same Firebase project. See docs/firebase-auth.md.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIRESTORE_NAMESPACE=app-cuoi-ky
# Backend only: absolute local path to a private credential file; never put in RN.
GOOGLE_APPLICATION_CREDENTIALS=
# Public OAuth Web application client ID; Android client package/SHA-1 must match.
# No OAuth client secret is needed. See docs/google-sign-in.md.
GOOGLE_WEB_CLIENT_ID=
FIRESTORE_SEED_DEMO=false
PORT=3000
HOST=0.0.0.0
DEMO_MODE=false
# Use a private trusted LAN for development; HTTP is development-only.
# Optional ANDROID_HOME/JAVA_HOME can also be set in your shell.
